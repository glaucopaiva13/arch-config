
{
	"position": "top",
		"height": 24,
		"modules-left": ["hyprland/workspaces", "mpris"],
		"modules-center": ["hyprland/window"],
		"modules-right": ["pulseaudio", "backlight", "cpu","memory","battery", "clock", "tray", "custom/power"],	

		"idle_inhibitor": {
			"format": "{icon}",
			"format-icons": {
				"activated": " ",
				"deactivated": " "
			},
			"tooltip": false
		},
		"tray": {
			"spacing": 0
		},
		"clock": {
			"format": "{:%d/%m/%Y %H:%M}",
			"tooltip": false
		},
		"cpu": {
			"format": " {usage}%",
			"interval": 1,
			"tooltip": true,
			"tooltip-format": "{cores}"
		},
		"memory": {
			"format": " {}%",
			"interval": 1
		},
		"backlight": {
			"format": " {percent}%",
			"tooltip": false
		},
		"battery": {
			"states": {
				"good": 95,
				"warning": 30,
				"critical": 15
			},
			"format": "{icon} {capacity}%",
			"format-charging": " {capacity}%",
			"format-plugged": " {capacity}%",
			"format-alt": "{time}",
			"format-icons": [
				"",
			"",
			"",
			"",
			""
			]
		},
			"custom/power": {
				"format": " ",
				"tooltip": false,
				"on-click": "systemctl poweroff"
			},
			"pulseaudio": {
				"format": "  {volume}%",
				"format-bluetooth": " {volume}%",
				"on-click": "pavucontrol"
			},
			"mpris": {
				"format": " {player_icon} {artist} - {title} ",
				"format-paused": "  {artist} - {title} ",
				"player-icons": {
					"spotify": ""
				},
				"max-length": 40
			}

}
